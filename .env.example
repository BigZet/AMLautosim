# Copy to .env and fill in before the first `docker compose up`.
# Values marked REQUIRED have no default: compose refuses to start without them.

# PostgreSQL 16 (docker compose service "db")
POSTGRES_DB=aml_simulator
POSTGRES_USER=aml
# REQUIRED. Generate one, e.g. `openssl rand -base64 24`.
POSTGRES_PASSWORD=
# Published on 127.0.0.1 only, for local psql and the test suite.
POSTGRES_PORT=5432

# FastAPI
DATABASE_URL=postgresql+asyncpg://aml:@localhost:5432/aml_simulator
SESSION_TTL_MINUTES=240
LOGIN_MAX_FAILED_ATTEMPTS=10
LOGIN_LOCKOUT_MINUTES=5
# Published on 127.0.0.1 only: browsers must never reach the API directly.
API_PORT=8000

# Streamlit
API_URL=http://localhost:8000
PLAY_PORT=8501
ADMIN_PORT=8502
# Set to true when the UI is served over HTTPS (production).
COOKIE_SECURE=false

# Bootstrap administrator created by scripts/seed_database.py.
# REQUIRED. The password follows the same policy as participant passwords:
# 10-128 characters. Change it from any value that has ever been committed.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=
