# PostgreSQL 16 (docker compose service "db")
POSTGRES_DB=aml_simulator
POSTGRES_USER=aml
POSTGRES_PASSWORD=aml
POSTGRES_PORT=5432

# FastAPI
DATABASE_URL=postgresql+asyncpg://aml:aml@localhost:5432/aml_simulator
SECRET_KEY=change-me-for-production
SESSION_TTL_MINUTES=240
API_PORT=8000

# Streamlit
API_URL=http://localhost:8000
PLAY_PORT=8501
ADMIN_PORT=8502
# Set to true when the UI is served over HTTPS (production).
COOKIE_SECURE=false

# Reverse proxies whose X-Forwarded-For may be believed, comma separated CIDRs.
# Empty (the default) means the API trusts nothing but the address of the socket
# it is talking to. Set it to the network of the Streamlit containers - for the
# bundled compose file that is the docker bridge, e.g. 172.16.0.0/12 - if the
# administrator must see the address of the participant's browser instead of the
# address of the UI container. Never list a network you do not control.
TRUSTED_PROXY_IPS=

# Bootstrap administrator created by scripts/seed_database.py
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=admin12345
