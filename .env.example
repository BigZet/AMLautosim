# Copy to .env. Single-quote secrets containing $, #, spaces or other special characters.
# Generate passwords with: openssl rand -hex 24
POSTGRES_DB=aml_simulator
POSTGRES_USER=aml
POSTGRES_PASSWORD=
# Host tools use localhost; Compose passes db:5432 to the API explicitly.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Optional local override: percent-encode special characters in URL credentials.
# DATABASE_URL=postgresql+asyncpg://user:encoded-password@localhost:5432/aml_simulator

API_PORT=8000
# Disable only creation of new expanded rounds; existing snapshots remain usable.
EXPANDED_ROUNDS_ENABLED=true
# Authentication limits must be positive integers; invalid values prevent startup.
SESSION_TTL_MINUTES=240
LOGIN_MAX_FAILED_ATTEMPTS=10
LOGIN_LOCKOUT_MINUTES=5

# NiceGUI reads these from process environment. Compose supplies them automatically.
API_URL=http://localhost:8000
UI_HOST=127.0.0.1
UI_PORT=8080
# Required by Compose. Generate with: openssl rand -hex 32
NICEGUI_STORAGE_SECRET=
NICEGUI_STORAGE_PATH=.nicegui
# Direct HTTP testing uses false. Enable only when HTTPS is configured later.
COOKIE_SECURE=false

BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# Required by Compose; 10–128 characters. Existing accounts keep their password.
BOOTSTRAP_ADMIN_PASSWORD=
# Paths are resolved against the project root unless absolute.
# AML_MODEL_PATH is only the legacy contract-v8 model.
AML_MODEL_PATH=resources/catboost_models/integration-v2-final
# AML_PROBABILITY_MODEL_PATH is the default published contract-v10 classifier.
AML_PROBABILITY_MODEL_PATH=resources/catboost_models/aml-game-organizer-settings-v1
