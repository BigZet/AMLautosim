# Use the digest from the release-provenance artifact, not a mutable tag.
AML_IMAGE=ghcr.io/bigzet/amlautosim@sha256:REPLACE_WITH_VERIFIED_DIGEST
POSTGRES_DB=aml_simulator
POSTGRES_USER=aml
POSTGRES_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
NICEGUI_STORAGE_SECRET=
AUTH_CONTEXT_SECRET=
AUTH_PAIR_PER_MINUTE=10
AUTH_IP_PER_MINUTE=300
AUTH_IP_BURST=120
UI_PORT=8080
# Only ingress is published; nicegui.nginx.conf restricts the verified LB source IP.
# Use INGRESS_BIND=127.0.0.1 only when the reverse proxy runs on the same host.
INGRESS_BIND=0.0.0.0
# TLS terminates at the trusted external load balancer. Secure cookies are enforced.
